---
layout: root.njk
title: Posts | Alexander Bolotskov
eleventyImport:
  collections: ["post"]
---
<section class="section topograph">
	<div class="container">
		<h1 style="view-transition-name: page-header-my-posts">My posts</h1>
	</div>
</section>
<section class="section">
	<div class="container grid grid-cols-2 p-0" role="list">
		{%- for post in collections.post -%}
			<div class="p-4 border relative gap-y-4" role="listitem" aria-label="{{ post.data.title }}">
				<a class="before:absolute before:inset-0 before:z-10" href="{{ post.url }}">
					{{ post.data.title }}
				</a>
				<div class="flex gap-4">
					<span>
						<span class="sr-only">Posted at </span>
						<time datetime="{{ post.data.date }}"></time>
					</span>
					<ul class="inline-flex gap-4">
						{%- for tag in post.data.tags -%}
							{% if tag != "post" %}
								<li class="tag-{{ tag | trim }}">{{ tag | trim }}</li>
							{% endif %}
						{%- endfor -%}
					</ul>
				</div>
			</div>
		{%- endfor -%}
	</div>
</section>
